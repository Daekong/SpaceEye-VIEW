#version 410 core

// Quads topology, equal spacing, counter-clockwise
layout (quads, equal_spacing, ccw) in;

// Input from Tessellation Control Shader
in dvec3 tcsPos[];

// Output to Fragment Shader (for texture mapping)
out vec3 vNormal;

// Uniform matrices and radius
uniform dmat4 model;
uniform dmat4 view;
uniform dmat4 projection;
uniform double radius;

void main() {
    // Local 2D coordinates within the patch generated by the tessellator (0.0 to 1.0)
    double u = gl_TessCoord.x;
    double v = gl_TessCoord.y;

    // Bilinear interpolation to calculate the 3D position on the cube plane
    dvec3 p0 = mix(tcsPos[0], tcsPos[1], u);
    dvec3 p1 = mix(tcsPos[3], tcsPos[2], u);
    dvec3 p = mix(p0, p1, v);

    // Normalize the plane coordinate to make it a perfect sphere direction vector
    dvec3 normal = normalize(p);

    // Cast to 32-bit float and pass to Fragment Shader
    vNormal = vec3(normal);

    // Multiply the normalized vector by the Earth's radius
    dvec3 spherePos = normal * radius;

    // Final clip space position calculation (MVP matrix multiplication)
    gl_Position = vec4(projection * view * model * dvec4(spherePos, 1.0lf));
}